# Workspace for files, attachments, DBs
ATHOS_WORKSPACE=${SCRATCH}/athos/workspace

# Servicenow settings
# SERVICENOW_INSTANCE_URL=https://nerscdev.servicenowservices.com
# SERVICENOW_USERNAME=<service-account>
# SERVICENOW_PASSWORD=<service-account-pass>
# SERVICENOW_AUTH_TYPE=basic

# SFAPI settings
# NERSC_CLIENT_ID=<your-client-id>
# NERSC_PRIVATE_KEY_PATH=<path/to/key.pem>

# Iris settings
# IRIS_BASE_URL=https://iris.nersc.gov

# LBNL CBorg settings
# CBORG_API_KEY=<api-key>
# CBORG_API_URL=<api-url>

# Slack Socket Mode settings for `athos-slack-consulting`.
# Install with: pip install -e '.[slack]'
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# ATHOS_SLACK_ALLOWED_USERS=U012ABC123,U045DEF456
# ATHOS_CONFIG_PATH=config/config.yaml
# ATHOS_FLOW_NAME=lang_hpc_consulting_agent
# ATHOS_FEEDBACK_DB=data/slack/feedback.db

# Open WebUI pipelines shared secret (used by scripts/deploy_podmanhpc.sh;
# docker-compose falls back to the public Open WebUI default if unset).
# Generate with: openssl rand -base64 24 | tr -d '/+='
# PIPELINES_API_KEY=<random-key>
